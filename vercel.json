{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(css|js|images|assets)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(.*)\\.(jpg|jpeg|png|gif|svg|ico|css|js)$",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
